# ─── Required ────────────────────────────────────────────────────────────
# Supabase project URL and anon key (Settings > API in your Supabase project).
# The app builds and manual profile editing works with just these two.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ─── AI provider (optional) ─────────────────────────────────────────────
# Powers the natural-language update box on /dashboard/updates. Without
# any of this set, that one feature is disabled with a clear message —
# everything else works regardless.
#
# Set AI_PROVIDER to pick one explicitly: anthropic | openai | gemini | local | custom
# If you leave AI_PROVIDER unset, the first provider below with a key
# present is used automatically.

AI_PROVIDER=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local model — any server exposing an OpenAI-compatible /v1/chat/completions
# endpoint: Ollama, LM Studio, llama.cpp's server, vLLM. Set AI_PROVIDER=local
# to use this even if you also have a cloud key set above.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
# Set to "false" if your local server rejects the response_format field.
LOCAL_AI_JSON_MODE=true

# Custom — any other OpenAI-compatible hosted API (OpenRouter, Groq,
# Together, Azure OpenAI). Set AI_PROVIDER=custom to use this.
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_API_KEY=


# ─── Portfolio integration (optional) ───────────────────────────────────
# Needed for the public /api/profile?token= endpoint and the
# external-sync inbound endpoint — i.e. letting a separately deployed
# portfolio read your data or push edits back without a session.
# Supabase Project Settings > API > service_role key (secret side).
# Server-side only — never expose this to the browser.

SUPABASE_SERVICE_ROLE_KEY=

# GitHub scanning needs no key — it reads public repo data through the
# unauthenticated GitHub API. Your username is set from /dashboard/sync.
