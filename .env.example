NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — only needed for the AI update-parsing feature on /dashboard/updates.
# Manual profile editing works fully without this.
ANTHROPIC_API_KEY=

# Optional — only needed for the public /api/profile?token= endpoint and
# the external-sync inbound endpoint (letting a separately deployed
# portfolio read your data or push edits back). Find this in Supabase
# under Project Settings > API > service_role key. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# No key needed for GitHub scanning — it only reads public repo data via
# the unauthenticated GitHub API. Your username is set from the Sync page.
